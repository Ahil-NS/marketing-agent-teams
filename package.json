{
  "name": "marketing-agent-teams",
  "version": "0.1.4",
  "description": "AI-powered marketing automation platform with 30 agents across 7 clusters",
  "type": "module",
  "bin": {
    "mat": "bin/mat"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "src/agents",
    "src/verticals",
    "src/templates",
    "src/dashboard",
    "oclif.manifest.json"
  ],
  "scripts": {
    "build": "tsup && npx oclif manifest",
    "dev": "bin/dev",
    "test": "vitest run",
    "lint": "eslint .",
    "manifest": "npx oclif manifest",
    "postpack": "rm -f oclif.manifest.json",
    "prepack": "tsup && npx oclif manifest"
  },
  "oclif": {
    "bin": "mat",
    "dirname": "mat",
    "flexibleTaxonomy": true,
    "topicSeparator": " ",
    "commands": "./dist/commands",
    "hooks": {
      "init": "./dist/hooks/init",
      "prerun": "./dist/hooks/prerun",
      "command_not_found": "./dist/hooks/command-not-found"
    },
    "topics": {
      "review": {
        "description": "Manage content review queue"
      },
      "config": {
        "description": "View and modify configuration"
      },
      "agents": {
        "description": "Manage agents"
      }
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "marketing",
    "ai",
    "agents",
    "automation",
    "cli"
  ],
  "author": "Ahil Ahilendran (https://www.npmjs.com/~ahilendran)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahil-NS/marketing-agent-teams.git"
  },
  "homepage": "https://github.com/Ahil-NS/marketing-agent-teams#readme",
  "bugs": {
    "url": "https://github.com/Ahil-NS/marketing-agent-teams/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.63",
    "@inquirer/prompts": "^8.3.0",
    "@oclif/core": "^4.8.1",
    "keytar": "^7.9.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@oclif/test": "^4.1.16",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.2",
    "eslint": "^10.0.2",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
